{
  "name": "nchat",
  "private": true,
  "version": "0.0.0",
  "description": "NChat corporate internal chat monorepo",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev:web": "pnpm --filter @nchat/web dev",
    "dev:admin-web": "pnpm --filter @nchat/admin-web dev",
    "dev:env:up": "bash scripts/dev/dev-env-up.sh",
    "dev:env:down": "bash scripts/dev/dev-env-down.sh",
    "dev:env:reset": "bash scripts/dev/dev-env-reset.sh",
    "dev:env:status": "bash scripts/dev/dev-env-status.sh",
    "dev:env:logs": "bash scripts/dev/dev-env-logs.sh",
    "dev:env:validate": "bash scripts/dev/dev-env-validate.sh",
    "dev:gateway:up": "bash scripts/dev/dev-gateway-up.sh",
    "dev:gateway:down": "bash scripts/dev/dev-gateway-down.sh",
    "dev:gateway:status": "bash scripts/dev/dev-gateway-status.sh",
    "dev:gateway:logs": "bash scripts/dev/dev-gateway-logs.sh",
    "dev:gateway:validate": "bash scripts/dev/dev-gateway-validate.sh",
    "dev:env:config-check": "bash scripts/ci/dev-env-config-check.sh",
    "gateway:config-check": "bash scripts/ci/gateway-config-check.sh",
    "web:security-headers-check": "bash scripts/ci/web-security-headers-check.sh",
    "web:livekit-integration-check": "bash scripts/ci/web-livekit-integration-check.sh",
