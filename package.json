    "migrations:down": "bash scripts/db/migrate.sh down",
    "migrations:status": "bash scripts/db/migrate.sh status",
    "migrations:reset": "bash scripts/db/migrate.sh reset",
    "migrations:smoke": "bash scripts/db/migrations-smoke.sh",
    "db:restore-test": "bash scripts/db/postgres-restore-test.sh",
    "prod:blue-green:check": "bash scripts/ci/prod-blue-green-check.sh",
    "prod:stateful:check": "bash scripts/ci/prod-stateful-check.sh",
    "prod:stateful:check-test": "bash scripts/ci/test_prod_stateful_check.sh",
    "prod:stateful:preflight-test": "bash scripts/ci/test_prod_stateful_preflight.sh",
    "prod:stateful:apply": "bash scripts/deploy/nchat-prod/stateful.sh",
    "prod:blue-green:check-test": "bash scripts/ci/test_prod_blue_green_check.sh",
    "prod:blue-green:test": "bash scripts/ci/test_prod_blue_green_scripts.sh",
    "prod:blue-green:query-test": "python3 scripts/ci/test_prod_blue_green_query.py",
    "prod:capacity:test": "bash scripts/ci/test_prod_capacity_preflight.sh",
    "prod:build-images:test": "bash scripts/ci/test_build_images_workflow.sh",
    "prod:release-manifest:test": "bash scripts/ci/test_release_manifest.sh",
    "prod:deploy-workflow:test": "bash scripts/ci/test_deploy_prod_workflow.sh",
    "prod:capacity:evidence": "bash scripts/deploy/nchat-prod/capacity-evidence.sh",
    "migrations:blue-green:test": "bash scripts/ci/test_blue_green_migration_gate.sh",
    "prod:blue-green:status": "bash scripts/deploy/nchat-prod/status.sh",
    "prod:blue-green:bootstrap": "bash scripts/deploy/nchat-prod/bootstrap.sh",
    "prod:blue-green:deploy": "bash scripts/deploy/nchat-prod/deploy.sh",
    "prod:blue-green:smoke": "bash scripts/deploy/nchat-prod/smoke.sh",
    "prod:blue-green:cutover": "bash scripts/deploy/nchat-prod/cutover.sh",
    "prod:blue-green:rollback": "bash scripts/deploy/nchat-prod/rollback.sh",
    "prod:blue-green:drain-old": "bash scripts/deploy/nchat-prod/drain-old.sh",
    "dev:observability:up": "bash scripts/dev/dev-observability-up.sh",
    "dev:observability:down": "bash scripts/dev/dev-observability-down.sh",
    "dev:observability:status": "bash scripts/dev/dev-observability-status.sh",
    "dev:observability:logs": "bash scripts/dev/dev-observability-logs.sh",
    "dev:observability:validate": "bash scripts/dev/dev-observability-validate.sh",
    "dev:media:up": "bash scripts/dev/dev-media-up.sh",
    "dev:media:down": "bash scripts/dev/dev-media-down.sh",
    "dev:media:status": "bash scripts/dev/dev-media-status.sh",
    "dev:media:logs": "bash scripts/dev/dev-media-logs.sh",
    "dev:media:validate": "bash scripts/dev/dev-media-validate.sh",
    "media:config-check": "bash scripts/ci/media-config-check.sh",
    "qa:webrtc-office-network": "bash scripts/qa/validate-webrtc-office-network.sh",
    "webrtc-office-network:config-check": "bash scripts/ci/webrtc-office-network-config-check.sh"
