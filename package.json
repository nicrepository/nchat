  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "prettier": "^3.8.3",
    "ws": "^8.18.3"
  }
}
