    "lint:admin-web": "pnpm --filter @nchat/admin-web lint",
    "format:web": "prettier \"apps/*/**/*.{ts,tsx,js,jsx,json,css,md}\" --write",
    "format:check:web": "prettier \"apps/*/**/*.{ts,tsx,js,jsx,json,css,md}\" --check",
    "format:docs": "prettier \"**/*.{md,yml,yaml,json}\" --write",
    "format:check:docs": "prettier \"**/*.{md,yml,yaml,json}\" --check",
    "test:web": "pnpm --filter @nchat/web test",
    "test:admin-web": "pnpm --filter @nchat/admin-web test",
    "test:e2e:web": "pnpm --filter @nchat/web test:e2e",
    "test:e2e:admin-web": "pnpm --filter @nchat/admin-web test:e2e",
    "test:coverage:web": "pnpm --filter @nchat/web test:coverage",
    "test:coverage:admin-web": "pnpm --filter @nchat/admin-web test:coverage",
    "typecheck:web": "pnpm --filter @nchat/web typecheck",
    "typecheck:admin-web": "pnpm --filter @nchat/admin-web typecheck",
    "test:go": "bash scripts/ci/go-test.sh",
    "test:coverage:go": "bash scripts/ci/go-coverage.sh",
    "test:coverage:go:check": "bash scripts/ci/go-coverage-check.sh",
    "vet:go": "bash scripts/ci/go-vet.sh",
    "fmt:go": "bash scripts/ci/go-fmt-check.sh",
    "lint:go": "bash scripts/ci/go-lint.sh",
    "format:go": "bash scripts/dev/go-format.sh",
    "format": "pnpm format:go && pnpm format:web && pnpm format:docs",
    "format:check": "pnpm fmt:go && pnpm format:check:web && pnpm format:check:docs",
    "test": "pnpm test:web && pnpm test:admin-web && pnpm test:go",
    "test:coverage": "pnpm test:coverage:web && pnpm test:coverage:admin-web && pnpm test:coverage:go:check",
    "lint": "pnpm lint:web && pnpm lint:admin-web && pnpm lint:go && pnpm vet:go",
    "build": "pnpm build:web && pnpm build:admin-web",
    "security:govulncheck": "bash scripts/security/govulncheck.sh",
    "security:trivy:fs": "bash scripts/security/trivy-fs.sh",
    "security:trivy:config": "bash scripts/security/trivy-config.sh",
    "security:secrets": "bash scripts/security/secrets-scan.sh",
    "security": "pnpm security:secrets && pnpm security:govulncheck && pnpm security:trivy:fs && pnpm security:trivy:config",
    "ci": "pnpm format:check && pnpm ci:config-check && pnpm images:module-inputs-check && pnpm images:module-inputs-check-test && pnpm poc:config-check && pnpm observability:config-check && pnpm grafana:dashboard-check && pnpm dev:env:config-check && pnpm gateway:config-check && pnpm web:security-headers-check && pnpm media:config-check && pnpm webrtc-office-network:config-check && pnpm tls:config-check && pnpm sealed-secrets:policy-check && pnpm k8s:ci && pnpm prod:blue-green:check && pnpm prod:blue-green:check-test && pnpm prod:stateful:check && pnpm prod:stateful:check-test && pnpm prod:stateful:preflight-test && pnpm prod:blue-green:test && pnpm prod:blue-green:query-test && pnpm prod:capacity:test && pnpm prod:build-images:test && pnpm prod:release-manifest:test && pnpm prod:deploy-workflow:test && pnpm health:contract-check && pnpm migrations:check && pnpm migrations:blue-green:test && pnpm lint && pnpm typecheck:web && pnpm typecheck:admin-web && pnpm test && pnpm test:coverage && pnpm build",
