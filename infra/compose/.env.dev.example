# NChat local development environment
# Copy this file to .env.dev before running scripts.
# Do not commit .env.dev.

COMPOSE_PROJECT_NAME=nchat-dev

POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_HOST_PORT=5432
POSTGRES_DB=nchat
POSTGRES_USER=nchat
POSTGRES_PASSWORD=nchat_dev_password_change_me

VALKEY_IMAGE=valkey/valkey:8-alpine
VALKEY_HOST_PORT=6379
VALKEY_PASSWORD=nchat_valkey_dev_password_change_me

# ClamAV (RF-22). file-service streams each upload to this daemon and persists
# the verdict; the port is published to 127.0.0.1 only and the daemon is never
# exposed to the network.
CLAMAV_IMAGE=clamav/clamav:1.4
CLAMAV_HOST_PORT=3310
# Skip the signature auto-update daemon in local development: the image ships a
# database, and a fetch on every start makes the container slow to become
# healthy. Set to false when testing against current signatures.
CLAMAV_NO_FRESHCLAMD=true

SEAWEEDFS_IMAGE=chrislusf/seaweedfs:latest
SEAWEEDFS_MASTER_HOST_PORT=9333
SEAWEEDFS_VOLUME_HOST_PORT=8088
SEAWEEDFS_FILER_HOST_PORT=8888
SEAWEEDFS_S3_HOST_PORT=8333
SEAWEEDFS_REPLICATION=000

# SeaweedFS second volume — used only with profile seaweed-replication (PoC TASK-15)
# Requires SEAWEEDFS_REPLICATION=001 and two running volume servers.
SEAWEEDFS_VOLUME_2_HOST_PORT=8089

# Local gateway
TRAEFIK_IMAGE=traefik:v3.6
# RF-32 upload guard: pinned, unprivileged nginx listening on 8080 as non-root.
UPLOAD_GUARD_IMAGE=nginxinc/nginx-unprivileged:1.27.4-alpine
TRAEFIK_HTTP_HOST_PORT=8080
TRAEFIK_HTTPS_HOST_PORT=8443
TRAEFIK_DASHBOARD_HOST_PORT=8090
TRAEFIK_TLS_CERT_FILE=/certs/nchat.local.pem
TRAEFIK_TLS_KEY_FILE=/certs/nchat.local-key.pem
NCHAT_LOCAL_HOST=nchat.local
NCHAT_LOCAL_HTTPS_URL=https://nchat.local:8443

# Host service ports
WEB_HOST_PORT=5173
AUTH_SERVICE_HOST_PORT=8081
CHAT_SERVICE_HOST_PORT=8082
FILE_SERVICE_HOST_PORT=8083
NOTIFICATION_SERVICE_HOST_PORT=8084
ADMIN_SERVICE_HOST_PORT=8085
SEARCH_SERVICE_HOST_PORT=8086
MEDIA_SERVICE_HOST_PORT=8087

# Observability — profile: observability
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1
GRAFANA_IMAGE=grafana/grafana-oss:11.4.0
JAEGER_IMAGE=jaegertracing/all-in-one:1.62.0

PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
JAEGER_UI_HOST_PORT=16686
JAEGER_OTLP_GRPC_HOST_PORT=4317
JAEGER_OTLP_HTTP_HOST_PORT=4318

# Dev-only Grafana credentials. Do not use in production.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

OBSERVABILITY_ENABLED=true
OTEL_ENABLED=true
OTEL_SERVICE_NAMESPACE=nchat
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
PROMETHEUS_METRICS_ENABLED=true

# Isolated LibreOffice converter used by file-service document previews.
DOCUMENT_CONVERTER_HOST_PORT=8089

# LiveKit media server (dev) — profile: media
# Prep for media-service, LiveKit + coturn base (V1.0 Sprints 9-10).
LIVEKIT_IMAGE=livekit/livekit-server:v1.13.3
LIVEKIT_HOST_PORT=7880
LIVEKIT_RTC_TCP_HOST_PORT=7881
# Narrow dev-only UDP range. Widen only if you need more concurrent participants.
LIVEKIT_RTC_UDP_PORT_START=50100
LIVEKIT_RTC_UDP_PORT_END=50110
# IP advertised to clients for ICE candidates. 127.0.0.1 works for same-host
# testing on Windows/Docker Desktop. For another device, set the LAN IP only
# as part of the TASK-158 MEDIA_COMPOSE_EXTRA_FILE override/render/up flow.
LIVEKIT_NODE_IP=127.0.0.1
# Dev-only placeholders. Replace in .env.dev, never commit real values.
LIVEKIT_API_KEY=nchat_dev_key_change_me
LIVEKIT_API_SECRET=nchat_dev_livekit_secret_change_me_32c

# CSP connect-src allowlist for the web app's LiveKit endpoint (issue #528).
# Consumed by envsubst in infra/k8s/base/web/deployment.yaml /
# Dockerfile.web; not read by compose.dev.yml today (no web service there).
NCHAT_WEB_LIVEKIT_CONNECT_SRC="wss://livekit-dev.nic-labs.com https://livekit-dev.nic-labs.com"

# coturn TURN/STUN server (dev) — profile: media
COTURN_IMAGE=coturn/coturn:4.14.0-r0
COTURN_LISTENING_PORT=3478
# Narrow dev-only relay UDP range. Widen only if you need more concurrent relays.
COTURN_RELAY_MIN_PORT=49160
COTURN_RELAY_MAX_PORT=49200
COTURN_REALM=nchat.local.dev
# Dev-only placeholder shared secret (TURN REST API / use-auth-secret). Replace
# in .env.dev, never commit real values. Must match between coturn and LiveKit.
COTURN_STATIC_AUTH_SECRET=nchat_dev_coturn_secret_change_me
# Hostname LiveKit uses to reach coturn inside the nchat-dev Docker network.
COTURN_HOST=coturn
