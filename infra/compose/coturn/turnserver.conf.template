# coturn dev config template (TASK: livekit-coturn-dev)
#
# This file is a TEMPLATE. It contains only placeholders — no real secrets.
# scripts/dev/_media_env.sh renders it into turnserver.runtime.conf (gitignored)
# using envsubst + values from infra/compose/.env.dev before the container starts.
#
# Security notes (dev-only, see docs/runbooks/task-livekit-coturn-dev.md):
# - use-auth-secret + static-auth-secret means this is NOT an open relay:
#   every TURN allocation requires a valid time-limited HMAC credential.
# - no-cli disables the coturn admin CLI (default ports 5766/5767).
# - Relay UDP ports are restricted to a small range for dev (see min-port/max-port).
# - No TLS listener is configured (dev only, no public certs — see "fora do escopo").
# - All ports are published on 127.0.0.1 by default (see compose.dev.yml), which
#   is the primary control against exposing coturn beyond the local host.

listening-port=${COTURN_LISTENING_PORT}

# Long-term credential mechanism using a shared secret (TURN REST API style).
# LiveKit (and any other client) derives short-lived username/password pairs
# from this secret instead of using a single static username/password.
use-auth-secret
static-auth-secret=${COTURN_STATIC_AUTH_SECRET}
realm=${COTURN_REALM}

# Restrict the relay port range so only a small set of dev ports needs to be
# published/documented (see runbook "Portas TCP/UDP").
min-port=${COTURN_RELAY_MIN_PORT}
max-port=${COTURN_RELAY_MAX_PORT}

fingerprint
stale-nonce=600
no-multicast-peers
no-cli
no-tls
no-dtls

log-file=stdout
simple-log
