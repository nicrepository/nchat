APP_ENV=development
PORT=8082
READ_HEADER_TIMEOUT_SECONDS=5
DATABASE_URL=postgres://nchat:nchat@localhost:5432/nchat?sslmode=disable
DB_CONNECT_TIMEOUT_SECONDS=5

# JWT access token validation (must match auth-service configuration).
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
# When missing or too short, the sidebar endpoint returns 503.
AUTH_JWT_HMAC_SECRET=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api

# Valkey connection string required by the reaction anti-abuse limiter and
# also used by the optional mention-label cache and WS broadcast bus. A
# database-backed chat-service reports unready while this is empty. Provide via
# Sealed Secrets/vault in staging and production — see
# docs/security/secrets-owners.md for the owner of this secret. May embed
# credentials (e.g. valkey://:password@host:6379); never hardcode a real
# value here or in code.
VALKEY_URL=

# TTL (seconds) for cached mention labels (display names) resolved from
# Valkey. Defaults to 45s if unset or non-positive. Lower values propagate
# display-name changes and account deactivation/deletion ("right to be
# forgotten") faster, at the cost of more load on Valkey.
MENTION_LABEL_CACHE_TTL_SECONDS=45
