APP_ENV=development
PORT=8082
READ_HEADER_TIMEOUT_SECONDS=5
DATABASE_URL=postgres://nchat:nchat@localhost:5432/nchat?sslmode=disable
DB_CONNECT_TIMEOUT_SECONDS=5

# JWT access token validation (must match auth-service configuration).
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
# When missing or too short, the sidebar endpoint returns 503.
AUTH_JWT_HMAC_SECRET=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api

# Valkey connection string required by the reaction anti-abuse limiter and
# also used by the optional mention-label cache and WS broadcast bus. A
# database-backed chat-service reports unready while this is empty. Provide via
# Sealed Secrets/vault in staging and production — see
# docs/security/secrets-owners.md for the owner of this secret. May embed
# credentials (e.g. valkey://:password@host:6379); never hardcode a real
# value here or in code.
VALKEY_URL=

# Per-user reaction actions allowed in each Valkey-backed window. Missing,
# invalid, zero, or negative values use the current 60 actions / 60 seconds.
REACTION_RATE_LIMIT_MAX_ACTIONS=60
REACTION_RATE_LIMIT_WINDOW_SECONDS=60

# TTL (seconds) for cached mention labels (display names) resolved from
# Valkey. Defaults to 45s if unset or non-positive. Lower values propagate
# display-name changes and account deactivation/deletion ("right to be
# forgotten") faster, at the cost of more load on Valkey.
MENTION_LABEL_CACHE_TTL_SECONDS=45

# RF-21 Safe Browsing. Before a message carrying a link is shown to anyone,
# every distinct URL in it -- scheme, host, path and query -- is decided by
# Cloudflare URL Scanner. The unit is the whole URL and not the host: a verdict
# about a domain used to clear every path on it, so a phishing page on a
# compromised subdirectory inherited its host's reputation.
#
# The provider is submit-then-poll (its result endpoint answers 404 while a scan
# runs, and Cloudflare recommends polling every 10-30 seconds), so this cannot
# happen inside the send. Three outcomes instead:
#
#   - every URL already cleared and still fresh -> the message is published
#     immediately, exactly as before RF-21;
#   - any URL reported malicious -> refused. No row, no broadcast, HTTP 403 with
#     code malicious_url;
#   - any URL not yet decided -> the message is accepted and *withheld*. It is
#     persisted with status pending_link_scan, which every read path already
#     excludes, so nobody else is shown it; a background worker submits the scan
#     and publishes the message once every URL clears, or drops it if one does
#     not.
#
# Off by default: enabling it makes message delivery depend on a third party.
# While it is on, a verdict that cannot be obtained never becomes a clearance --
# the message simply stays withheld and the worker keeps retrying. Messages with
# no link are never affected.
#
# Enabled without credentials is a start-up failure, not a degraded mode.
#
# Verdict TTL and the scan queue's cadence are constants in
# libs/go/platform/urlsafety and in the worker, shared with file-service, so the
# two services cannot disagree about how long a URL stays cleared.
CHAT_LINK_SAFETY_ENABLED=false

# Cloudflare account identifier and a custom API token created with
# Account > URL Scanner in the Permissions group and Edit as the access level --
# Edit because submitting a scan creates one. Do NOT grant Intel permissions:
# Domain Intelligence is not on this path (issue #526).
#
# Placeholders only -- never commit a real token here or in code, and never send
# either value to the frontend. Provide them via Sealed Secrets/vault in staging
# and production; see docs/security/secrets-owners.md.
CHAT_LINK_SAFETY_CLOUDFLARE_ACCOUNT_ID=
CHAT_LINK_SAFETY_CLOUDFLARE_API_TOKEN=

# RF-21 capacity. What this deployment is willing to spend at the provider.
#
# The unit throughout is a *new canonical URL*: one with no fresh verdict and no
# scan already queued. A cached clearance, a URL another message is already
# waiting on, a duplicate inside one body and an idempotent replay are all free,
# because none of them costs Cloudflare anything.
#
# None of these have a correct value this code can pick. The right submission
# rate is whatever the Cloudflare plan this deployment is billed under allows,
# and nothing in the code may assume a plan — set them from the contract you
# actually have. The defaults below are conservative: they refuse early rather
# than spending an account's quota at whatever rate the replicas manage.

# How many new canonical URLs one workspace may introduce per window. Shared by
# create, DM, edit and forward, so no endpoint is a way around the others.
# 0 disables the budget.
CHAT_LINK_SAFETY_WORKSPACE_BUDGET=60
CHAT_LINK_SAFETY_BUDGET_WINDOW_SECONDS=3600

# Deployment-wide cap on undecided scans. This is the backpressure that keeps a
# slow provider from making every tenant's messages wait behind a queue nobody
# can drain. 0 disables the cap; must fit at least one full message (10 URLs).
CHAT_LINK_SAFETY_MAX_PENDING_JOBS=500

# Submissions to Cloudflare per window, across every replica. This is the one
# that has to match the plan: a per-process limiter multiplied by the replica
# count is not a limit on the thing the provider counts. 0 disables it.
CHAT_LINK_SAFETY_PROVIDER_SUBMIT_LIMIT=30
CHAT_LINK_SAFETY_PROVIDER_SUBMIT_WINDOW_SECONDS=60

# When a submission whose outcome was never recorded starts being reported as
# stale, so an operator can find it.
#
# It gates no action. There is deliberately no setting that lets an uncertain
# submission be sent again: once a POST may have reached Cloudflare, no amount of
# elapsed time makes another one safe, and Cloudflare has no idempotency token
# that would make a second one free. Crossing this threshold changes one metric
# label and nothing else — reconciliation continues either way.
#
# Restarting the worker does not resubmit either. If this number of seconds keeps
# being exceeded, the answer is the runbook, not a retry.
CHAT_LINK_SAFETY_SUBMIT_UNCERTAIN_TIMEOUT_SECONDS=900
