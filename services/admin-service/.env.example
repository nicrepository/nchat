APP_ENV=development
PORT=8085
READ_HEADER_TIMEOUT_SECONDS=5

# Admin API (issue #578). Without DATABASE_URL and AUTH_JWT_HMAC_SECRET the
# service still serves /healthz, /readyz and /version, and every privileged
# route answers 503 instead of serving without its guards.
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
AUTH_JWT_HMAC_SECRET=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api

# Administrative session policy. Deliberately stricter than the chat session's
# 60-minute idle window: this console can suspend accounts and read the audit
# trail.
ADMIN_SESSION_IDLE_MINUTES=15
ADMIN_SESSION_ABSOLUTE_MINUTES=480


# Explicit CORS allowlist for the administrative browser origin, comma
# separated. Leave empty when the console and the Admin API share a host, which
# is the deployed topology. A "*" entry is dropped: it is never valid alongside
# credentials.
ADMIN_ALLOWED_ORIGINS=

ADMIN_SESSION_RATE_LIMIT_PER_MINUTE=30
ADMIN_SESSION_RATE_LIMIT_BURST=10
