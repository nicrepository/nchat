APP_ENV=development
PORT=8084
READ_HEADER_TIMEOUT_SECONDS=5

# Database
DATABASE_URL=postgres://user:password@localhost:5432/nchat_dev
DB_CONNECT_TIMEOUT_SECONDS=5

# Auth service integration
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY=""
AUTH_PUBLIC_WEB_BASE_URL=http://localhost:3000

# SMTP configuration
SMTP_HOST=CHANGE_ME_smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME_user@example.com
SMTP_PASSWORD=""
SMTP_FROM=CHANGE_ME_noreply@example.com
SMTP_FROM_NAME=NChat
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT_SECONDS=10
SMTP_MAX_ATTEMPTS=5
SMTP_BACKOFF_SECONDS=60
# SMTP_WORKER_ENABLED=false
SMTP_WORKER_POLL_SECONDS=10
