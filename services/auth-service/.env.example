APP_ENV=development
PORT=8081
READ_HEADER_TIMEOUT_SECONDS=5
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
# Bootstrap credential for POST /admin/invites, the initialization-only route
# that creates a workspace's first owner. Leave BOTH this and
# AUTH_BOOTSTRAP_WORKSPACE_ID empty to keep the endpoint disabled.
#
# When set, it must be exactly 32 random bytes in unpadded Base64URL (43
# characters); the service refuses to start otherwise, and refuses a
# half-configured pair as well. Generate one with:
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
# The value below is a deliberately invalid placeholder — replace it before
# enabling the bootstrap endpoint.
ADMIN_BOOTSTRAP_TOKEN=
# ADMIN_BOOTSTRAP_TOKEN=changeme-generate-a-real-32-byte-base64url-value
# Workspace the bootstrap invite is issued into. Required whenever
# ADMIN_BOOTSTRAP_TOKEN is set, and never read from a request.
AUTH_BOOTSTRAP_WORKSPACE_ID=
# Guesses allowed at the bootstrap credential, per client IP, counted in
# PostgreSQL so the budget is shared by every replica. Charged before the
# credential is compared, so a wrong and a right token cost the same. Zero is
# not "unlimited": a value outside 1..100 attempts or 1..1440 minutes falls back
# to the default. Disable the endpoint by unsetting the credential instead.
AUTH_BOOTSTRAP_RATE_LIMIT_ATTEMPTS=5
AUTH_BOOTSTRAP_RATE_LIMIT_WINDOW_MINUTES=15

# JWT access + refresh token foundation.
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
# If it is missing or too short, /auth/refresh and /auth/logout return 503.
AUTH_JWT_HMAC_SECRET=
# Base64-encoded 32-byte AES-GCM key for encrypted reset/invite outbox handoff.
# No default. Generate with: openssl rand -base64 32
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_PER_MINUTE=60
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_BURST=10
# Comma-separated trusted proxy CIDRs for X-Forwarded-For/X-Real-IP rate-limit keys.
# Empty means use RemoteAddr only. Set to the Traefik source CIDR when behind Traefik.
AUTH_TRUSTED_PROXY_CIDRS=

# User avatar storage. AUTH_AVATAR_DIR must point at a writable, persistent
# directory (a mounted volume in production). Empty disables the avatar
# endpoints. AUTH_AVATAR_BASE_URL is the same-origin, root-relative prefix under
# which avatars are served and persisted into auth.users.avatar_url.
AUTH_AVATAR_DIR=
AUTH_AVATAR_BASE_URL=/api/auth/avatars


# Keycloak OIDC / SSO (RF-44). Disabled by default.
# Leave values empty unless OIDC_ENABLED=true. Do not commit real provider secrets.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=keycloak
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_FRONTEND_CALLBACK_URL=/oidc-callback
OIDC_SCOPES="openid email profile"
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_STATE_TTL_MINUTES=10
OIDC_AUTO_PROVISION_ENABLED=false
OIDC_ALLOWED_EMAIL_DOMAINS=
