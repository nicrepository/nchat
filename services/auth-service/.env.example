APP_ENV=development
PORT=8081
READ_HEADER_TIMEOUT_SECONDS=5
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
ADMIN_BOOTSTRAP_TOKEN=

# JWT access + refresh token foundation.
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
# If it is missing or too short, /auth/refresh and /auth/logout return 503.
AUTH_JWT_HMAC_SECRET=
# Base64-encoded 32-byte AES-GCM key for encrypted reset/invite outbox handoff.
# No default. Generate with: openssl rand -base64 32
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_PER_MINUTE=60
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_BURST=10
# Comma-separated trusted proxy CIDRs for X-Forwarded-For/X-Real-IP rate-limit keys.
# Empty means use RemoteAddr only. Set to the Traefik source CIDR when behind Traefik.
AUTH_TRUSTED_PROXY_CIDRS=
