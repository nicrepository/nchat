APP_ENV=development
PORT=8081
READ_HEADER_TIMEOUT_SECONDS=5
DATABASE_URL=
DB_CONNECT_TIMEOUT_SECONDS=5
ADMIN_BOOTSTRAP_TOKEN=

# JWT access + refresh token foundation.
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
# If it is missing or too short, /auth/refresh and /auth/logout return 503.
AUTH_JWT_HMAC_SECRET=
# Base64-encoded 32-byte AES-GCM key for encrypted reset/invite outbox handoff.
# No default. Generate with: openssl rand -base64 32
AUTH_EMAIL_OUTBOX_ENCRYPTION_KEY=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_PER_MINUTE=60
AUTH_TOKEN_ENDPOINT_RATE_LIMIT_BURST=10
# Comma-separated trusted proxy CIDRs for X-Forwarded-For/X-Real-IP rate-limit keys.
# Empty means use RemoteAddr only. Set to the Traefik source CIDR when behind Traefik.
AUTH_TRUSTED_PROXY_CIDRS=

# User avatar storage. AUTH_AVATAR_DIR must point at a writable, persistent
# directory (a mounted volume in production). Empty disables the avatar
# endpoints. AUTH_AVATAR_BASE_URL is the same-origin, root-relative prefix under
# which avatars are served and persisted into auth.users.avatar_url.
AUTH_AVATAR_DIR=
AUTH_AVATAR_BASE_URL=/api/auth/avatars


# Keycloak OIDC / SSO (RF-44). Disabled by default.
# Leave values empty unless OIDC_ENABLED=true. Do not commit real provider secrets.
OIDC_ENABLED=false
OIDC_PROVIDER_NAME=keycloak
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Provider callback URI for the chat application, absolute and registered at the
# identity provider. Example: https://nchat.example.com/api/auth/oidc/keycloak/callback
OIDC_REDIRECT_URL=
# Provider callback URI for the administrative console, which is served from its
# own origin (issue #578). Leave empty to have no single sign-on on that host —
# it never falls back to the chat URI. Both URIs must be registered as valid
# redirect URIs on the same Keycloak client.
# Example: https://admin.nchat.example.com/api/auth/oidc/keycloak/callback
OIDC_ADMIN_REDIRECT_URL=
# Root-relative path both applications serve for the post-login handoff. It is
# relative on purpose: the browser stays on whichever origin the callback ran on.
OIDC_FRONTEND_CALLBACK_URL=/oidc-callback
# Administrative authentication context (issue #578). Comma-separated list of
# `acr` values this deployment accepts as proof that the administrative
# authentication flow ran — the value your Keycloak flow actually emits, which
# this project never invents.
#
# Empty states no requirement and the console signs in like the chat. Non-empty
# makes it fail-closed: the administrative login asks Keycloak for the context
# and refuses a token that does not come back with one of these values. Leave
# empty for local development.
# Example: OIDC_ADMIN_ACR_VALUES=nchat-admin-mfa
OIDC_ADMIN_ACR_VALUES=
OIDC_SCOPES="openid email profile"
OIDC_HTTP_TIMEOUT_SECONDS=10
OIDC_STATE_TTL_MINUTES=10
OIDC_AUTO_PROVISION_ENABLED=false
OIDC_ALLOWED_EMAIL_DOMAINS=
