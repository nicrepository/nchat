# Required whenever FILE_MALWARE_SCAN_REQUIRED=false: the scan gate can only be
# disabled in an explicitly declared development environment. There is no
# default — see the FILE_MALWARE_SCAN_REQUIRED block below.
APP_ENV=development
PORT=8083
READ_HEADER_TIMEOUT_SECONDS=5

# Upload and download stream up to the effective size limit, so the body
# timeouts are generous. Slow-request protection comes from
# READ_HEADER_TIMEOUT_SECONDS and from the byte cap, not from these.
READ_TIMEOUT_SECONDS=300
WRITE_TIMEOUT_SECONDS=300

# RF-30/RF-32/RF-33 attachments. While false the service is health-only and no
# other variable below is required. While true every one of them is validated
# at start-up and the service refuses to boot if any is missing or malformed.
FILE_UPLOADS_ENABLED=false

DATABASE_URL=postgres://nchat:nchat@localhost:5432/nchat?sslmode=disable
DB_CONNECT_TIMEOUT_SECONDS=5

# Connection pool size. It must leave headroom above FILE_UPLOAD_MAX_CONCURRENT:
# every in-flight upload reserves one connection for its admission slot, and at
# least 4 must stay free for authorization, metadata writes and probes. Start-up
# fails if this is smaller than FILE_UPLOAD_MAX_CONCURRENT + 4.
FILE_DB_MAX_CONNECTIONS=10

# Cluster-wide upload admission. These bound uploads that are *in flight*, which
# the per-minute rate limiter cannot: that one counts request starts, in one
# process, so N replicas grant N budgets and a client holding several slow
# transfers open is never counted at all.
#
# Slots are PostgreSQL session advisory locks, so the limit holds across every
# replica and a crashed process releases its slots with its connections.
#
# Sizing: each global slot is one reserved connection and, at the 512 MiB
# ceiling, up to that much plaintext being streamed, encrypted and forwarded at
# once — 4 slots put the worst case at 2 GiB of simultaneous transfers for the
# whole cluster. Raise both together with FILE_DB_MAX_CONNECTIONS and with the
# service's memory and bandwidth budget.
#
# Zero is not accepted and does not mean "unlimited": start-up fails.
FILE_UPLOAD_MAX_CONCURRENT=4
FILE_UPLOAD_MAX_CONCURRENT_PER_USER=2
# Retry-After sent with the 429 (user at capacity) and 503 (cluster at capacity).
FILE_UPLOAD_RETRY_AFTER_SECONDS=30

# JWT access token validation (must match auth-service configuration).
# AUTH_JWT_HMAC_SECRET has no default and must be at least 32 bytes.
AUTH_JWT_HMAC_SECRET=
AUTH_JWT_ISSUER=nchat-auth
AUTH_JWT_AUDIENCE=nchat-api

# Deployment ceiling for one attachment, in bytes. This is NOT the RF-32 limit:
# since issue #458 the limit is administrative (per workspace, set through
# PATCH /api/chat/workspaces/{id}/upload-limit, default 262144000 = 250 MiB) and
# is read from the database on every upload.
#
# This variable only narrows that policy further, for a cluster that cannot
# absorb it. Leave it unset -- the default is the domain ceiling (536870912 =
# 512 MiB), so it never binds and the administrative value is what applies.
# Accepted range is 1048576 (1 MiB) to 536870912 (512 MiB); a value outside it
# stops start-up rather than being silently corrected.
# FILE_MAX_UPLOAD_BYTES=

# RF-33 / RNF-17 envelope encryption master key (KEK): standard base64 of
# exactly 32 random bytes, e.g. `openssl rand -base64 32`. There is no default
# and no fallback -- uploads cannot start without it. Provide via Sealed
# Secrets or the organisation secret manager and never commit a real value
# here; see docs/security/secrets-owners.md for the secret owner.
FILE_ENCRYPTION_MASTER_KEY=

# Non-secret label of the key above, persisted with every wrapped data key so a
# download knows which KEK opens it instead of trying the ones it has. Required
# whenever uploads are enabled. Lowercase, [a-z0-9][a-z0-9._-]{0,63}; a dated
# label such as kek-2026-08 makes a rotation readable in the database.
FILE_ENCRYPTION_MASTER_KEY_ID=

# Optional, and empty outside a rotation: comma-separated "id:key" pairs of KEKs
# kept only so objects wrapped before the rotation can still be read. New uploads
# always use the active key above; an id that is not on this list or the active
# one is refused rather than guessed. Rotation procedure in
# docs/runbooks/file-service-envelope-encryption.md.
# FILE_ENCRYPTION_PREVIOUS_KEYS=

# When true (the default) an upload finishes in pending_scan and cannot be
# downloaded until the asynchronous antimalware worker marks it clean, which is
# what SECURITY.md requires. Setting it to false is a local-development
# affordance for an environment that has no scanner: uploads then finalise as
# clean and are immediately downloadable.
#
# This is enforced, not merely documented: the service refuses to start with
# FILE_MALWARE_SCAN_REQUIRED=false unless APP_ENV explicitly names a development
# environment (development, dev, local, test, nchat-dev; case and surrounding
# whitespace are ignored).
#
# APP_ENV has no default. Absent, empty, unknown or misspelled is treated as a
# deployed environment and the value is rejected — which is why APP_ENV is set
# at the top of this file rather than left to a fallback.
FILE_MALWARE_SCAN_REQUIRED=true

# clamd endpoint for the asynchronous scan worker (RF-22), as host:port. There
# is no scheme, no path and no credentials — it is a dial target, and anything
# that looks like a URL is refused at start-up.
#
# Empty is a supported deployment and does NOT relax the gate: with no scanner
# the worker does not start, so every upload stays in pending_scan and stays
# undownloadable. Only FILE_MALWARE_SCAN_REQUIRED changes what an upload
# finalises as, and only in an explicitly declared development environment.
#
# The daemon must accept streams at least as large as the biggest attachment
# this deployment will take (uploadpolicy's ceiling is 512 MiB). A clamd with a
# smaller StreamMaxLength refuses those streams, the scan fails, and the file is
# never approved — see infra/compose/clamav/clamd.conf for the matching limits.
FILE_MALWARE_SCANNER_ADDRESS=localhost:3310

# The effective budget for scanning one attachment, and the only one. It bounds
# the exchange with the daemon (connect, stream, reply) *and* the worker's job
# deadline, and the claim lease is derived from it — so raising it really does
# give large files more time rather than being overridden by a fixed internal
# deadline.
#
# It has to cover streaming the largest attachment this deployment accepts, so
# it is generous by default. A non-positive value falls back to the default;
# anything above 3600 is refused at start-up, because the value becomes a
# duration and the lease is derived from it.
FILE_MALWARE_SCAN_TIMEOUT_SECONDS=300

# Broadcast bus shared with chat-service. file-service publishes an
# attachment.status event on it after each verdict is persisted, so connected
# clients reconcile without waiting for their next poll.
#
# Optional: without it verdicts are still persisted and still authoritative, and
# clients see them on their next read. It is never a source of truth.
VALKEY_URL=valkey://localhost:6379

# Identifies this process on that bus, for the consumer's echo suppression.
# 1-64 characters of [A-Za-z0-9._-]; anything else is ignored and a random value
# is generated instead.
WS_INSTANCE_ID=

# SeaweedFS filer endpoint. Origin only: no credentials, path, query or
# fragment. This is the access path validated by make poc-seaweedfs and
# make dev-env-validate.
SEAWEEDFS_FILER_URL=http://localhost:8888
SEAWEEDFS_TIMEOUT_SECONDS=120

# --- Open Graph link previews (RF-10) ---------------------------------------

# Server-side preview of external links: file-service fetches the linked page
# and returns only its Open Graph metadata. No JavaScript, no browser, no
# subresources, and the destination is validated by resolved IP address before
# every connection and again at every redirect.
#
# Off by default, like FILE_UPLOADS_ENABLED, because the feature makes this
# service open outbound connections to hosts a user names. While false the route
# answers 503 and no fetcher is built. Enabling it requires AUTH_JWT_HMAC_SECRET
# (the route is authenticated); it needs no database, storage or key material,
# so it can run with uploads disabled.
FILE_LINK_PREVIEW_ENABLED=false

# Budget for one whole remote exchange, in seconds. Short on purpose: a user is
# waiting on it and a site that cannot answer in time gets no preview. Capped at
# 30. The per-phase budgets (dial, TLS handshake, response headers) are smaller
# still and are not configurable: they are properties of the sandbox.
FILE_LINK_PREVIEW_TIMEOUT_SECONDS=5

# How long a successful preview is reused, in seconds. Capped at 86400. Failures
# are cached separately, for one minute, so a dead link retried in a loop does
# not cost a timeout every time.
FILE_LINK_PREVIEW_CACHE_TTL_SECONDS=900

# RF-21 Safe Browsing. Before any Open Graph fetch, the destination's whole URL
# -- scheme, host, path and query -- is decided by Cloudflare URL Scanner. The
# unit is the URL and not the host, because a preview renders one page and
# deciding it by the reputation of the domain hosting it cleared every path on
# that domain.
#
# The provider is submit-then-poll, so a URL nobody has scanned has no verdict
# yet. That is not a clearance and not a fetch: the scan is queued and the
# request answers 202 with code link_check_pending. No page is ever requested
# before a verdict exists -- fetching first and asking afterwards is rendering
# the phishing page.
#
# Off by default: enabling it makes previews depend on a third party being
# reachable. It is NOT a replacement for the SSRF policy above -- that one
# decides whether this service may connect at all, and it still runs for every
# URL that gets past this check.
#
# When true, both credentials below are required and start-up fails without
# them: a check that is switched on but cannot run would remove the control
# while the feature keeps working, and the only symptom would be that nothing is
# ever blocked.
#
# Verdict TTL is NOT configurable. It is the semantics of a verdict shared with
# chat-service and lives as a constant in libs/go/platform/urlsafety, so the two
# services cannot disagree about how long a URL stays cleared. The API endpoint
# is not configurable either: an operator-supplied one would be a way to point a
# security check at something that always answers "safe".
FILE_LINK_SAFETY_ENABLED=false

# Cloudflare account identifier and a custom API token created with
# Account > URL Scanner in the Permissions group and Edit as the access level --
# Edit because submitting a scan creates one. Do NOT grant Intel permissions:
# Domain Intelligence is not on this path (issue #526).
#
# Placeholders only -- never commit a real token here or in code, and never send
# either value to the frontend. Provide them via Sealed Secrets/vault in staging
# and production; see docs/security/secrets-owners.md.
FILE_LINK_SAFETY_CLOUDFLARE_ACCOUNT_ID=
FILE_LINK_SAFETY_CLOUDFLARE_API_TOKEN=

# RF-21 capacity for the preview pipeline. Same unit as chat-service: a *new
# canonical URL*, one with no fresh verdict and no scan already queued.
# Previewing the same link repeatedly is free, because it is free for Cloudflare
# too.
#
# The new-URL budget is service-wide rather than per tenant, and that is a
# limitation rather than an oversight: a preview request carries no workspace
# this service can trust — it is fetched for a link, not for a tenant — and
# deriving one from a header would be a boundary any client could choose.
# Per-caller fairness stays in FILE_LINK_PREVIEW_RATE_* , which is where it can
# actually be enforced.
#
# As above, the right numbers come from the Cloudflare plan this deployment is
# billed under. The defaults are conservative.
FILES_LINK_SAFETY_NEW_URL_BUDGET=120
FILES_LINK_SAFETY_BUDGET_WINDOW_SECONDS=3600

# Cap on undecided scans in this service. 0 disables it.
FILES_LINK_SAFETY_MAX_PENDING_JOBS=500

# Submissions to Cloudflare per window, across every replica of this service.
FILES_LINK_SAFETY_PROVIDER_SUBMIT_LIMIT=30
FILES_LINK_SAFETY_PROVIDER_SUBMIT_WINDOW_SECONDS=60

# When a submission whose outcome was never recorded starts being reported as
# stale. It gates no action — there is deliberately no setting that lets an
# uncertain submission be sent again. See the chat-service .env.example.
FILES_LINK_SAFETY_SUBMIT_UNCERTAIN_TIMEOUT_SECONDS=900
