# Environment and local configuration
.env
.env.*
!.env.example
!.env.*.example
infra/compose/.env.dev
*.local
*.local.*

# Rendered LiveKit/coturn dev config (contains real secrets, see *.template sources)
infra/compose/livekit/livekit.runtime.yaml
infra/compose/coturn/turnserver.runtime.conf

# Operator's local copy of the office-network LAN bind override (real IP —
# never the committed .example.yml). See TASK-158 runbook.
infra/compose/compose.media.lan-office-test.override.yml

# Secrets, private keys, certificates, and dumps
*.pem
*.key
*.p12
*.pfx
*.crt
*.csr
*.jks
*.keystore
!*.example.pem
!*.example.crt
id_rsa
id_dsa
id_ecdsa
id_ed25519
*.dump
*.sql.gz
*.bak
*.backup
*.enc
secrets/
private/
!infra/k8s/secrets/
!infra/k8s/secrets/**
!scripts/secrets/
!scripts/secrets/**

# Local TLS material
infra/traefik/local/certs/*.pem
infra/traefik/local/certs/*.key
infra/traefik/local/certs/*.crt
infra/traefik/local/certs/*
!infra/traefik/local/certs/.gitkeep
!infra/traefik/local/certs/README.md

# Kubernetes unsealed secrets
infra/k8s/secrets/unsealed/*
!infra/k8s/secrets/unsealed/.gitkeep
!infra/k8s/secrets/unsealed/README.md

# Local Sealed Secrets public cert cache
infra/k8s/secrets/public-certs/*
!infra/k8s/secrets/public-certs/.gitkeep
!infra/k8s/secrets/public-certs/README.md

# Logs and runtime files
*.log
logs/
tmp/
temp/
*.tmp
*.swp
*.swo
.DS_Store
Thumbs.db

