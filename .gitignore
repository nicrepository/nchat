agentdb.rvf
agentdb.rvf.lock
ruvector.db

# Local PoC outputs
poc-results/*
!poc-results/.gitkeep
# WebRTC office network validation (TASK-158): keep the sanitized template
# versioned, but never the raw run summaries (may contain office network IPs).
!poc-results/webrtc-office-network/
poc-results/webrtc-office-network/*
!poc-results/webrtc-office-network/RESULT-TEMPLATE.md

# Playwright local artifacts
apps/web/playwright-report/
apps/web/test-results/

# Security scan artifacts
results.sarif
*.sarif
*.patch
*_results.txt
semgrep_results.json
trivy_results.json
kustomize_render.yaml
